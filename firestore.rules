rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsDocument(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProfile(data, userId) {
      return data.keys().hasOnly([
          'uid', 'name', 'birthDate', 'nickname', 'photoURL',
          'email', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'uid', 'name', 'birthDate', 'nickname', 'photoURL',
          'email', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && data.name is string
        && data.name.size() <= 120
        && data.birthDate is string
        && data.birthDate.size() <= 10
        && data.birthDate.matches('^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.nickname is string
        && data.nickname.size() <= 30
        && (data.photoURL == null || data.photoURL is string)
        && data.email is string
        && data.email == request.auth.token.email
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if ownsDocument(userId);
      allow create: if ownsDocument(userId)
        && validProfile(request.resource.data, userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsDocument(userId)
        && validProfile(request.resource.data, userId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /profilePhotos/{userId} {
      allow read: if ownsDocument(userId);
      allow create, update: if ownsDocument(userId)
        && request.resource.data.keys().hasOnly(['uid', 'dataUrl', 'contentType', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'dataUrl', 'contentType', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 980000
        && request.resource.data.dataUrl.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/]+={0,2}$')
        && request.resource.data.contentType is string
        && request.resource.data.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.data.updatedAt == request.time;
      allow delete: if ownsDocument(userId);
    }
  }
}
